    + stop(): void 
    }
class Helicopter { 
    - static MAX_WEIGHT: double
    - static MAX_SPEED: double
    - static REGISTRATION_TIME: LocalDateTime
    - static MIN_SPEED: double
    - static instanceCount: int
    + Helicopter()
    + Helicopter(emptyWeight: double, cruisingSpeed: double)
    + static getMaxWeight(): double
    + static getMaxSpeed(): double
    + static getRegistrationTime(): LocalDateTime
    + static count(): int
    + start(): void
